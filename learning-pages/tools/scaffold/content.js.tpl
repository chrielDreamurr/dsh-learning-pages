  },

  steps: [

/* ======================= 第 0 章 · 开始之前 ======================= */
{
  id:'s0-1', ch:'第 0 章 · 开始之前',
  title:'这份材料是给谁看的',
  body:`
  <p>先说清楚这份页面的定位：<b>它假设你在这个领域是零基础</b>，所以每个专业名词第一次出现时都会用生活里的东西打比方，并且单独放在青色的术语卡里。</p>
  <div class="callout c-term"><span class="lb">术语卡 · 术语名</span>
  用一句人话解释这个词。<b>先给比喻，再给定义。</b>不要用另一个术语来解释这个术语。</div>
  <p>页面每一节末尾都有一道选择题。答完立刻能看到每个选项为什么对、为什么错——<b>答错才是学习的时刻</b>，所以别怕选错。</p>
  <div class="callout c-key"><span class="lb">划重点</span>
  这是本节最核心的那一句话，用蓝色卡片框起来。<b>一节最多一个。</b></div>
  `,
  q:{ type:'survey', text:'你现在的状态是？（引导题：没有对错，用来选路线）',
    opts:[
      {label:'完全零基础，从第一节开始', desc:'按顺序走', next:'s1-1'},
      {label:'有点基础，想直接看重点', desc:'跳过铺垫', next:'s1-1'},
      {label:'我只想查一个具体问题', desc:'可以随时用左侧目录跳', next:'s2-1'}
    ],
    summary:'引导题不判对错，它的作用是让读者自己选路径。'
  }
},

/* ======================= 第 1 章 · 核心内容 ======================= */
{
  id:'s1-1', ch:'第 1 章 · 核心内容',
  title:'第一节正课：一个概念 + 一道题',
  body:`
  <p><b>一句话大意：</b>先用一句话把这个知识点说清楚，让读者知道接下来要学什么。</p>
  <p>再展开讲<b>为什么需要它</b>。零基础的人最容易被「怎么做」淹没，所以顺序永远是：<b>先讲为什么，再讲是什么，最后讲怎么做。</b></p>
  <div class="callout c-term"><span class="lb">术语卡 · 第二个术语</span>
  同样是生活化比喻 + 一句话定义。</div>
  <div class="callout c-warn"><span class="lb">小心坑</span>
  这是新手最容易翻车的地方。写清楚<b>现象是什么</b>、<b>原因是什么</b>、<b>怎么避免</b>。</div>
  <div class="callout c-tip"><span class="lb">小技巧</span>
  能省时间或提高正确率的实用经验。</div>
  `,
  q:{ type:'quiz', text:'这道题的问法是「下面哪个说法是对的」——题面要具体，不要问「你懂了吗」。',
    opts:[
      {label:'正确答案的写法：结论 + 一句理由', desc:'一句话说清它为什么对',
       correct:true,
       why:'正确答案的解释可以稍长，2~4 句。要讲清「为什么对」，而不是重复一遍选项本身。'},
      {label:'一个真实存在的常见误解', desc:'这是读者的第一直觉',
       why:'错误选项必须是<b>真的会有人这么想</b>的误解，不能是凑数的废话。解释要指出「哪里想错了」——这条最重要，因为读者大概率就是选了这一个。'},
      {label:'另一个看起来很像的干扰项', desc:'似是而非',
       why:'指出它错在哪个具体的点上。如果它只是「不够好」而不是「错」，那这个选项设计得有问题，应该换掉。'},
      {label:'一个明显荒谬的选项', desc:'凑数用的',
       why:'<b>不要放这种选项。</b>读者一眼排除，等于浪费了一个学习机会。好的选择题里，每个错误选项都对应一种真实的思维偏差。'}
    ],
    summary:'答题后显示的总结句：把这道题想传达的那一条认知单独拎出来。'
  }
},

/* ======================= 第 2 章 · 收尾 ======================= */
{
  id:'s2-1', ch:'第 2 章 · 收尾',
  title:'术语速查表 + 下一步',
  body:`
  <p>把全篇出现过的术语集中翻译一遍，方便读者做题卡住时回来查。</p>
  <div class="callout c-term"><span class="lb">术语速查表</span>
  <div class="term">
    <b>术语一</b><span>一句话解释。</span>
    <b>术语二</b><span>一句话解释。</span>
    <b>术语三</b><span>一句话解释。</span>
  </div></div>
  <div class="callout c-task"><span class="lb">动手任务</span>
  告诉读者看完之后<b>具体该去做什么</b>。只给方向，不要直接把答案写出来。</div>
  <div class="callout c-key"><span class="lb">下一步</span>
  给出后续学习路线，最好排个先后顺序。</div>
  `,
  q:{ type:'survey', text:'走完了。接下来做什么？',
    opts:[
      {label:'去动手做', desc:'最重要的一步', next:'s0-1'},
      {label:'回到某一节重看', desc:'用左侧目录跳', next:'s0-1'},
      {label:'从头再快速过一遍', desc:'加深印象', next:'s0-1'}
    ],
    summary:'看懂只是第一步，自己动手才是真正的学会。'
  }
}

  ]
};
