window.PAGE = {
  meta: {
    brand:      {{BRAND}},        // 侧栏顶部的大标题
    subtitle:   {{SUBTITLE}},     // 侧栏标题下面的小字
    docTitle:   {{DOC_TITLE}},    // 浏览器标签页标题
    storageKey: {{STORAGE_KEY}},  // 本地进度存档的键；内容大改后请把版本号 +1
